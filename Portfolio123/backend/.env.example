PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Supabase — run database/setup.sql first (see database/README.md).
# Leave empty locally to store data in backend/data/local-db.json instead. Required on Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email alert for every contact-form message (optional) — free key at https://resend.com
# Sign up to Resend with the same address as CONTACT_NOTIFY_EMAIL so the default sender can deliver to it.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=rkrrts@gmail.com
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Any long random string, used to hash visitor IPs for the contact-form limit (5 messages per hour)
RATE_LIMIT_SALT=
